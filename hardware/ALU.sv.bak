module ALU(
  input [3:0] Aluop,
  input [7:0] acc,
              inputReg,
  output logic[7:0] Rslt, 
  output logic      Zero,
                    Par,
		    SCo,
		    neg );//carry out
always_comb begin
  Rslt = 8'b0;
  SCo  = 1'b0;
  case(Aluop)
 	4'b0000: begin
	Rslt = acc & inputReg;   // and
	SCo = 1'b0;
	end
        4'b0001: begin
        {SCo,Rslt} = acc + inputReg;   // add
        end
	4'b0010: begin
        {SCo,Rslt} = acc - inputReg;   // sub
        end
	4'b1010: begin
	Rslt= acc | inputReg;   // or
	SCo = 1'b0;
	end
	4'b0110: begin
	Rslt = acc ^ inputReg;   // xor
	SCo = 1'b0;
	end
	4'b0111: begin //TST
	// condtional check for A >= B, c = 1 when that is true
	SCo = (acc > inputReg);
	end
	4'b1011: begin
    	Rslt = ~acc;  //not
    	SCo = 1'b0;     
	end
    	4'b1100: begin 
        {SCo,Rslt} = acc<<1'b1;    // left shift
        end
    	4'b1101: begin
        {SCo,Rslt} = acc>>1'b1;    // right shift
        end
	4'b1110: begin
	Rslt = inputReg;  // Pass through inputReg (for MOVI)
	SCo = 1'b0;
	end
	4'b1000: begin //for fill
    	Rslt = 8'hFF;
    	SCo  = 1'b0;
	end
	4'b1111: begin     // PASS_A_OP
    	Rslt = acc;    // pass accumulator input
    	SCo = 1'b0;
	end
   endcase
 end
assign Zero = ~|Rslt;
assign Par  = ^Rslt;
assign Neg  = Rslt[7]; //1 if result is negative

endmodule
