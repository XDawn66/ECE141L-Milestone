module ALU(
  input [3:0] Aluop,
  input [7:0] acc,
              inputReg,
  output logic[7:0] Rslt, 
  output logic      Zero,
                    Par,
		    SCo );//carry out
always_comb begin
  Rslt = 8'b0;
  SCo  = 1'b0;
  case(Aluop)
 	4'b0000:  begin
	Rslt = acc & inputReg;   // and
	SCo = 1'b0;
	end
    4'b0001: {SCo,Rslt} = acc + inputReg;   // add
	4'b0010: {SCo,Rslt} = acc - inputReg;   // sub
	4'b1010: begin
	Rslt= acc | inputReg;   // or
	SCo = 1'b0;
	end
	4'b0110: begin
	Rslt = acc ^ inputReg;   // xor
	SCo = 1'b0;
	end
	4'b0111: begin //TST
	// condtional check for A >= B, c = 1 when that is false
	SCo = (acc > inputReg);
	end
	4'b1011: begin
    	Rslt = ~acc;  //not
    	SCo = 1'b0;     
	end
    	4'b1100: {SCo,Rslt} = acc<<1'b1;    // left shift
    	4'b1101: {SCo,Rslt} = acc>>1'b1;    // right shift
  endcase
end

assign Zero = ~|Rslt;
assign Par  = ^Rslt;

endmodule
